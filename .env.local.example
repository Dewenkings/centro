# LLM 配置（DeepSeek）
# 申请地址：https://platform.deepseek.com/
LLM_API_KEY=你的_DeepSeek_API_Key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 高德地图 Web服务 Key
# 申请地址：https://console.amap.com/dev/key/app（选 Web服务）
AMAP_API_KEY=你的_高德_Key

# Upstash Redis（生产环境建议通过 Vercel Marketplace 自动注入）
UPSTASH_REDIS_REST_URL=你的_Upstash_REST_URL
UPSTASH_REDIS_REST_TOKEN=你的_Upstash_REST_Token

# 公共 Demo 可靠额度（北京时间自然日）
DEMO_RATE_LIMIT_ENABLED=true
DEMO_DAILY_PER_IP=3
DEMO_DAILY_GLOBAL=30
DEMO_BURST_PER_IP=2
DEMO_BURST_WINDOW_SECONDS=600
