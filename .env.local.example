# LLM 配置（DeepSeek）
# 申请地址：https://platform.deepseek.com/
LLM_API_KEY=你的_DeepSeek_API_Key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 高德地图 Web服务 Key
# 申请地址：https://console.amap.com/dev/key/app（选 Web服务）
AMAP_API_KEY=你的_高德_Key

# 公共 Demo 基础限流（进程内 best-effort；生产环境还应配置平台级限流）
DEMO_RATE_LIMIT_ENABLED=true
DEMO_RATE_LIMIT_REQUESTS=5
DEMO_RATE_LIMIT_WINDOW_MS=600000
